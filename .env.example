# Agent Smith environment configuration
# Copy to `.env` and fill in your values:  cp .env.example .env
# The agents load `.env` by default (override with --env-file).
# Values already set in the real environment are NOT overridden by the .env file.

# --- API credentials -------------------------------------------------------
# Provide credentials in ONE of the following ways.

# 1. Explicit list for Agent Smith (comma-separated; keys are rotated on failure)
AGENT_SMITH_API_KEYS=

# 2. Or a provider-specific key. Any variable whose name contains "API_KEY"
#    is discovered automatically.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Provider / model selection ------------------------------------------
# These have CLI equivalents (--model-name / --provider-url) which take precedence.
# Defaults if nothing is passed: model "gpt-5.4-mini", url "https://api.openai.com/v1".
# MODEL_NAME=openai/gpt-5.4-mini
# PROVIDER_URL=https://api.openai.com/v1

# --- SWE-bench only ------------------------------------------------------
# Path inside the task's Docker container where the repo is checked out.
# TESTBED_PATH=/testbed
